# Kushluk Stage 1 defaults. Copy to .env only if your runner loads env files.
KUSHLUK_HOME_NAME=Cologne
KUSHLUK_LATITUDE=50.9384
KUSHLUK_LONGITUDE=6.9603
KUSHLUK_TIMEZONE=Europe/Berlin
KUSHLUK_RSS_URLS=https://hnrss.org/frontpage
KUSHLUK_ARCHIVE_DIR=archive
KUSHLUK_OUTPUT_DIR=output

# Calendar: set KUSHLUK_CALENDAR_ICS to a local .ics path or http(s) ICS URL.
# When unset, the local fixture remains the Stage 1 fallback.
KUSHLUK_CALENDAR_ICS=
KUSHLUK_CALENDAR_FIXTURE=fixtures/calendar.json

# Printing
KUSHLUK_PRINTER=

# Optional SMTP digital delivery. Secrets stay in environment/runtime secret storage.
KUSHLUK_SMTP_HOST=
KUSHLUK_SMTP_PORT=587
KUSHLUK_SMTP_USERNAME=
KUSHLUK_SMTP_PASSWORD=
KUSHLUK_SMTP_FROM=
KUSHLUK_EMAIL_TO=
KUSHLUK_SMTP_STARTTLS=true
